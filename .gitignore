.env.test.local
.env.production.local

# Media files (keep structure, ignore content)
media/uploads/*
!media/uploads/.gitkeep
media/qr_codes/*
!media/qr_codes/.gitkeep

# Static files
static/
staticfiles/

# AI Sandbox logs
ai_sandbox/logs/*
